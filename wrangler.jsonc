{
  "name": "soren-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "AI_ENABLED": "true",
    "AI_PHASE": "development"
  },
  "d1_databases": [
    {
      "binding": "AI_BUDGET_DB",
      "database_name": "soren-ai-usage",
      "database_id": "609113d7-096f-4d8b-adff-e5e008befb4e"
    }
  ]
}
